{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InMyArtifact Reference v1 Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "digest",
    "size",
    "mediaType",
    "name",
    "sensitivity",
    "syncClass",
    "producer",
    "producerRevision"
  ],
  "properties": {
    "ref": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0, "maximum": 104857600 },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 129,
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sensitivity": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"] },
    "syncClass": { "type": "string", "enum": ["LOCAL_ONLY", "SYNC_ENCRYPTED", "CLOUD_ALLOWED", "PUBLIC"] },
    "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "producerRevision": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
