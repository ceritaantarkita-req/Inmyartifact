{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inmy.local/schemas/artifact-resolver-registry-v1.schema.json",
  "title": "InMyArtifact Resolver Binding Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "bindings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "localArtifactId",
          "digest",
          "size",
          "mediaType",
          "ownerProduct",
          "sensitivity",
          "syncClass",
          "producer",
          "producerRevision",
          "retention",
          "registeredAt",
          "updatedAt"
        ],
        "properties": {
          "artifactId": { "type": "string", "pattern": "^art_[A-Za-z0-9_-]{16,96}$", "maxLength": 100 },
          "localArtifactId": { "type": "string", "pattern": "^artifact_[0-9a-f-]{36}$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 104857600 },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 129,
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
          },
          "ownerProduct": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[A-Za-z0-9._:-]+$" },
          "sensitivity": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"] },
          "syncClass": { "type": "string", "enum": ["LOCAL_ONLY", "SYNC_ENCRYPTED", "CLOUD_ALLOWED", "PUBLIC"] },
          "producer": { "type": "string", "minLength": 1, "maxLength": 120 },
          "producerRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "authorityProduct", "leaseExpiresAt"],
            "properties": {
              "mode": { "type": "string", "enum": ["PRODUCT_PIN", "PRODUCT_LEASE"] },
              "authorityProduct": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[A-Za-z0-9._:-]+$" },
              "leaseExpiresAt": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "minLength": 20, "maxLength": 40 }
                ]
              }
            }
          },
          "registeredAt": { "type": "string", "minLength": 20, "maxLength": 40 },
          "updatedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
        }
      }
    }
  }
}
